;==============================================================================
; LeylineVAD.inf
; Leyline Virtual Audio WDM/WaveRT Multi-Bus Driver for Windows 10 & Windows 11
;==============================================================================

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/19/2026,1.0.0.1
CatalogFile = LeylineVAD.cat
PnpLockdown = 1

[Manufacturer]
%MfgName% = LeylineModels,NTamd64.10.0

[LeylineModels.NTamd64.10.0]
%LeylineVAD.DeviceDesc% = LeylineVAD_Install, ROOT\LeylineVAD

[DestinationDirs]
LeylineVAD.CopyList = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
LeylineVAD.sys = 1

[LeylineVAD.CopyList]
LeylineVAD.sys

[LeylineVAD_Install.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = LeylineVAD.CopyList
AddReg    = LeylineVAD.AddReg

[LeylineVAD.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,LeylineVAD.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer,aux"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%LeylineVAD.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%LeylineVAD.DeviceDesc%

[LeylineVAD_Install.NT.Interfaces]
; Playback (Render) Virtual Endpoints
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveSystem%,  LeylineVAD.I.WaveSystem
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveSystem%,  LeylineVAD.I.WaveSystem
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoSystem%,  LeylineVAD.I.TopoSystem

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveGame%,    LeylineVAD.I.WaveGame
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveGame%,    LeylineVAD.I.WaveGame
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoGame%,    LeylineVAD.I.TopoGame

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveBrowser%, LeylineVAD.I.WaveBrowser
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveBrowser%, LeylineVAD.I.WaveBrowser
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoBrowser%, LeylineVAD.I.TopoBrowser

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveMusic%,   LeylineVAD.I.WaveMusic
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveMusic%,   LeylineVAD.I.WaveMusic
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoMusic%,   LeylineVAD.I.TopoMusic

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveChat%,    LeylineVAD.I.WaveChat
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveChat%,    LeylineVAD.I.WaveChat
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoChat%,    LeylineVAD.I.TopoChat

; Recording (Capture / Loopback Output) Virtual Endpoints
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveStream%,  LeylineVAD.I.WaveStream
AddInterface = %KSCATEGORY_CAPTURE%, %KSNAME_WaveStream%,  LeylineVAD.I.WaveStream
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoStream%,  LeylineVAD.I.TopoStream

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveMicFx%,   LeylineVAD.I.WaveMicFx
AddInterface = %KSCATEGORY_CAPTURE%, %KSNAME_WaveMicFx%,   LeylineVAD.I.WaveMicFx
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoMicFx%,   LeylineVAD.I.TopoMicFx

[LeylineVAD.I.WaveSystem]
AddReg = LeylineVAD.I.WaveSystem.AddReg
[LeylineVAD.I.WaveSystem.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveSystem%

[LeylineVAD.I.TopoSystem]
AddReg = LeylineVAD.I.TopoSystem.AddReg
[LeylineVAD.I.TopoSystem.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoSystem%

[LeylineVAD.I.WaveGame]
AddReg = LeylineVAD.I.WaveGame.AddReg
[LeylineVAD.I.WaveGame.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveGame%

[LeylineVAD.I.TopoGame]
AddReg = LeylineVAD.I.TopoGame.AddReg
[LeylineVAD.I.TopoGame.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoGame%

[LeylineVAD.I.WaveBrowser]
AddReg = LeylineVAD.I.WaveBrowser.AddReg
[LeylineVAD.I.WaveBrowser.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveBrowser%

[LeylineVAD.I.TopoBrowser]
AddReg = LeylineVAD.I.TopoBrowser.AddReg
[LeylineVAD.I.TopoBrowser.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoBrowser%

[LeylineVAD.I.WaveMusic]
AddReg = LeylineVAD.I.WaveMusic.AddReg
[LeylineVAD.I.WaveMusic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveMusic%

[LeylineVAD.I.TopoMusic]
AddReg = LeylineVAD.I.TopoMusic.AddReg
[LeylineVAD.I.TopoMusic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoMusic%

[LeylineVAD.I.WaveChat]
AddReg = LeylineVAD.I.WaveChat.AddReg
[LeylineVAD.I.WaveChat.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveChat%

[LeylineVAD.I.TopoChat]
AddReg = LeylineVAD.I.TopoChat.AddReg
[LeylineVAD.I.TopoChat.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoChat%

[LeylineVAD.I.WaveStream]
AddReg = LeylineVAD.I.WaveStream.AddReg
[LeylineVAD.I.WaveStream.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveStream%

[LeylineVAD.I.TopoStream]
AddReg = LeylineVAD.I.TopoStream.AddReg
[LeylineVAD.I.TopoStream.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoStream%

[LeylineVAD.I.WaveMicFx]
AddReg = LeylineVAD.I.WaveMicFx.AddReg
[LeylineVAD.I.WaveMicFx.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveMicFx%

[LeylineVAD.I.TopoMicFx]
AddReg = LeylineVAD.I.TopoMicFx.AddReg
[LeylineVAD.I.TopoMicFx.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoMicFx%

[LeylineVAD_Install.NT.Services]
AddService = LeylineVAD, 0x00000002, LeylineVAD_Service_Inst

[LeylineVAD_Service_Inst]
DisplayName    = %LeylineVAD.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\LeylineVAD.sys

[Strings]
ProviderName            = "Leyline Audio"
MfgName                 = "Leyline Audio Systems"
DiskName                = "Leyline Virtual Audio Driver Installation Disk"
LeylineVAD.DeviceDesc = "Leyline Virtual Audio"
LeylineVAD.SvcDesc    = "Leyline Virtual Audio WDM WaveRT Driver"

Proxy.CLSID             = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO        = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER       = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE      = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"

KSNAME_WaveSystem       = "WaveSystem"
KSNAME_TopoSystem       = "TopoSystem"
Desc.WaveSystem         = "Leyline System"
Desc.TopoSystem         = "Leyline System Topology"

KSNAME_WaveGame         = "WaveGame"
KSNAME_TopoGame         = "TopoGame"
Desc.WaveGame           = "Leyline Game"
Desc.TopoGame           = "Leyline Game Topology"

KSNAME_WaveBrowser      = "WaveBrowser"
KSNAME_TopoBrowser      = "TopoBrowser"
Desc.WaveBrowser        = "Leyline Browser"
Desc.TopoBrowser        = "Leyline Browser Topology"

KSNAME_WaveMusic        = "WaveMusic"
KSNAME_TopoMusic        = "TopoMusic"
Desc.WaveMusic          = "Leyline Music"
Desc.TopoMusic          = "Leyline Music Topology"

KSNAME_WaveChat         = "WaveChat"
KSNAME_TopoChat         = "TopoChat"
Desc.WaveChat           = "Leyline Voice Chat"
Desc.TopoChat           = "Leyline Voice Chat Topology"

KSNAME_WaveStream       = "WaveStream"
KSNAME_TopoStream       = "TopoStream"
Desc.WaveStream         = "Leyline Stream Mix"
Desc.TopoStream         = "Leyline Stream Mix Topology"

KSNAME_WaveMicFx        = "WaveMicFx"
KSNAME_TopoMicFx        = "TopoMicFx"
Desc.WaveMicFx          = "Leyline Mic FX"
Desc.TopoMicFx          = "Leyline Mic FX Topology"
