;==============================================================================
; VoidPatchVAD.inf
; VoidPatch Virtual Audio WDM/WaveRT Multi-Bus Driver for Windows 10 & Windows 11
;==============================================================================

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/19/2026,1.0.0.1
CatalogFile = VoidPatchVAD.cat
PnpLockdown = 1

[Manufacturer]
%MfgName% = VoidPatchModels,NTamd64.10.0

[VoidPatchModels.NTamd64.10.0]
%VoidPatchVAD.DeviceDesc% = VoidPatchVAD_Install, ROOT\VoidPatchVAD

[DestinationDirs]
VoidPatchVAD.CopyList = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
VoidPatchVAD.sys = 1

[VoidPatchVAD.CopyList]
VoidPatchVAD.sys

[VoidPatchVAD_Install.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = VoidPatchVAD.CopyList
AddReg    = VoidPatchVAD.AddReg

[VoidPatchVAD.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,VoidPatchVAD.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer,aux"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%VoidPatchVAD.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%VoidPatchVAD.DeviceDesc%

[VoidPatchVAD_Install.NT.Interfaces]
; Playback (Render) Virtual Endpoints
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveSystem%,  VoidPatchVAD.I.WaveSystem
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveSystem%,  VoidPatchVAD.I.WaveSystem
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoSystem%,  VoidPatchVAD.I.TopoSystem

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveGame%,    VoidPatchVAD.I.WaveGame
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveGame%,    VoidPatchVAD.I.WaveGame
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoGame%,    VoidPatchVAD.I.TopoGame

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveBrowser%, VoidPatchVAD.I.WaveBrowser
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveBrowser%, VoidPatchVAD.I.WaveBrowser
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoBrowser%, VoidPatchVAD.I.TopoBrowser

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveMusic%,   VoidPatchVAD.I.WaveMusic
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveMusic%,   VoidPatchVAD.I.WaveMusic
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoMusic%,   VoidPatchVAD.I.TopoMusic

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveChat%,    VoidPatchVAD.I.WaveChat
AddInterface = %KSCATEGORY_RENDER%,  %KSNAME_WaveChat%,    VoidPatchVAD.I.WaveChat
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoChat%,    VoidPatchVAD.I.TopoChat

; Recording (Capture / Loopback Output) Virtual Endpoints
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveStream%,  VoidPatchVAD.I.WaveStream
AddInterface = %KSCATEGORY_CAPTURE%, %KSNAME_WaveStream%,  VoidPatchVAD.I.WaveStream
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoStream%,  VoidPatchVAD.I.TopoStream

AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_WaveMicFx%,   VoidPatchVAD.I.WaveMicFx
AddInterface = %KSCATEGORY_CAPTURE%, %KSNAME_WaveMicFx%,   VoidPatchVAD.I.WaveMicFx
AddInterface = %KSCATEGORY_AUDIO%,   %KSNAME_TopoMicFx%,   VoidPatchVAD.I.TopoMicFx

[VoidPatchVAD.I.WaveSystem]
AddReg = VoidPatchVAD.I.WaveSystem.AddReg
[VoidPatchVAD.I.WaveSystem.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveSystem%

[VoidPatchVAD.I.TopoSystem]
AddReg = VoidPatchVAD.I.TopoSystem.AddReg
[VoidPatchVAD.I.TopoSystem.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoSystem%

[VoidPatchVAD.I.WaveGame]
AddReg = VoidPatchVAD.I.WaveGame.AddReg
[VoidPatchVAD.I.WaveGame.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveGame%

[VoidPatchVAD.I.TopoGame]
AddReg = VoidPatchVAD.I.TopoGame.AddReg
[VoidPatchVAD.I.TopoGame.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoGame%

[VoidPatchVAD.I.WaveBrowser]
AddReg = VoidPatchVAD.I.WaveBrowser.AddReg
[VoidPatchVAD.I.WaveBrowser.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveBrowser%

[VoidPatchVAD.I.TopoBrowser]
AddReg = VoidPatchVAD.I.TopoBrowser.AddReg
[VoidPatchVAD.I.TopoBrowser.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoBrowser%

[VoidPatchVAD.I.WaveMusic]
AddReg = VoidPatchVAD.I.WaveMusic.AddReg
[VoidPatchVAD.I.WaveMusic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveMusic%

[VoidPatchVAD.I.TopoMusic]
AddReg = VoidPatchVAD.I.TopoMusic.AddReg
[VoidPatchVAD.I.TopoMusic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoMusic%

[VoidPatchVAD.I.WaveChat]
AddReg = VoidPatchVAD.I.WaveChat.AddReg
[VoidPatchVAD.I.WaveChat.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveChat%

[VoidPatchVAD.I.TopoChat]
AddReg = VoidPatchVAD.I.TopoChat.AddReg
[VoidPatchVAD.I.TopoChat.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoChat%

[VoidPatchVAD.I.WaveStream]
AddReg = VoidPatchVAD.I.WaveStream.AddReg
[VoidPatchVAD.I.WaveStream.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveStream%

[VoidPatchVAD.I.TopoStream]
AddReg = VoidPatchVAD.I.TopoStream.AddReg
[VoidPatchVAD.I.TopoStream.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoStream%

[VoidPatchVAD.I.WaveMicFx]
AddReg = VoidPatchVAD.I.WaveMicFx.AddReg
[VoidPatchVAD.I.WaveMicFx.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.WaveMicFx%

[VoidPatchVAD.I.TopoMicFx]
AddReg = VoidPatchVAD.I.TopoMicFx.AddReg
[VoidPatchVAD.I.TopoMicFx.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Desc.TopoMicFx%

[VoidPatchVAD_Install.NT.Services]
AddService = VoidPatchVAD, 0x00000002, VoidPatchVAD_Service_Inst

[VoidPatchVAD_Service_Inst]
DisplayName    = %VoidPatchVAD.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\VoidPatchVAD.sys

[Strings]
ProviderName            = "VoidPatch Audio"
MfgName                 = "VoidPatch Audio Systems"
DiskName                = "VoidPatch Virtual Audio Driver Installation Disk"
VoidPatchVAD.DeviceDesc = "VoidPatch Virtual Audio"
VoidPatchVAD.SvcDesc    = "VoidPatch Virtual Audio WDM WaveRT Driver"

Proxy.CLSID             = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO        = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER       = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE      = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"

KSNAME_WaveSystem       = "WaveSystem"
KSNAME_TopoSystem       = "TopoSystem"
Desc.WaveSystem         = "VoidPatch System"
Desc.TopoSystem         = "VoidPatch System Topology"

KSNAME_WaveGame         = "WaveGame"
KSNAME_TopoGame         = "TopoGame"
Desc.WaveGame           = "VoidPatch Game"
Desc.TopoGame           = "VoidPatch Game Topology"

KSNAME_WaveBrowser      = "WaveBrowser"
KSNAME_TopoBrowser      = "TopoBrowser"
Desc.WaveBrowser        = "VoidPatch Browser"
Desc.TopoBrowser        = "VoidPatch Browser Topology"

KSNAME_WaveMusic        = "WaveMusic"
KSNAME_TopoMusic        = "TopoMusic"
Desc.WaveMusic          = "VoidPatch Music"
Desc.TopoMusic          = "VoidPatch Music Topology"

KSNAME_WaveChat         = "WaveChat"
KSNAME_TopoChat         = "TopoChat"
Desc.WaveChat           = "VoidPatch Voice Chat"
Desc.TopoChat           = "VoidPatch Voice Chat Topology"

KSNAME_WaveStream       = "WaveStream"
KSNAME_TopoStream       = "TopoStream"
Desc.WaveStream         = "VoidPatch Stream Mix"
Desc.TopoStream         = "VoidPatch Stream Mix Topology"

KSNAME_WaveMicFx        = "WaveMicFx"
KSNAME_TopoMicFx        = "TopoMicFx"
Desc.WaveMicFx          = "VoidPatch Mic FX"
Desc.TopoMicFx          = "VoidPatch Mic FX Topology"
