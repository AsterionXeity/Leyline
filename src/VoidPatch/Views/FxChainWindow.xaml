<Window
    x:Class="VoidPatch.Views.FxChainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VoidPatch Studio DSP &amp; VST Chain">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Material Design 3 Header Bar -->
        <Border Grid.Row="0" Background="{ThemeResource BgSidebarBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="{ThemeResource AccentPillBgBrush}" CornerRadius="12">
                        <TextBlock x:Name="ChannelIconText" Text="🎙️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ChannelTitleText" Text="Microphone — Studio DSP &amp; VST Rack" FontSize="16.5" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock Text="Zero-Latency Studio DSP + External 64-bit VST2 / VST3 Plugin Hosting" FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="Pre-Amp Gain:" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"/>
                    <Slider x:Name="PreampSlider" Width="130" Minimum="-18" Maximum="18" StepFrequency="0.5"
                            Value="{Binding InputGainDbDouble, Mode=TwoWay}" VerticalAlignment="Center"/>
                    <Border Background="{ThemeResource BgPillBrush}" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InputGainDbText}" Width="56" TextAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable DSP & VST Rack -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel Spacing="16">
                <!-- Quick Studio Presets Bar -->
                <Border Background="{ThemeResource BgCardBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BUILT-IN VST PRESETS:" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Broadcast Voice" Tag="broadcast" Click="ApplyRackPreset_Click" Padding="12,5" CornerRadius="8" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="12"/>
                            <Button Content="Warm Studio Mic" Tag="warmmic" Click="ApplyRackPreset_Click" Padding="12,5" CornerRadius="8" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="12"/>
                            <Button Content="Crisp Gaming" Tag="gaming" Click="ApplyRackPreset_Click" Padding="12,5" CornerRadius="8" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="12"/>
                            <Button Content="Music &amp; Bass" Tag="music" Click="ApplyRackPreset_Click" Padding="12,5" CornerRadius="8" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="12"/>
                            <Button Content="Podcast Leveler" Tag="podcast" Click="ApplyRackPreset_Click" Padding="12,5" CornerRadius="8" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Reset All Built-in VSTs" Tag="reset" Click="ApplyRackPreset_Click" Padding="12,5" CornerRadius="8" Background="{ThemeResource BgMutedCellBrush}" Foreground="{ThemeResource BorderMutedCellBrush}" FontSize="12"/>
                    </Grid>
                </Border>

                <TextBlock Text="BUILT-IN STUDIO VST RACK (MATERIAL 3)" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>

                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. VoidGate -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource BgCardBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel DataContext="{Binding Dsp}" Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VOIDGATE • Noise Gate" FontWeight="Bold" FontSize="13.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Reset" Click="ResetGate_Click" Padding="8,3" CornerRadius="6" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="2" IsOn="{Binding GateEnabled, Mode=TwoWay}" OffContent="Off" OnContent="On"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Threshold" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GateThresholdDbText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="-75" Maximum="-5" StepFrequency="1" Value="{Binding GateThresholdDbDouble, Mode=TwoWay}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Attack Time" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GateAttackMsText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" StepFrequency="1" Value="{Binding GateAttackMsDouble, Mode=TwoWay}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Release Time" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GateReleaseMsText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="20" Maximum="600" StepFrequency="5" Value="{Binding GateReleaseMsDouble, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. VoidEQ -->
                    <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource BgCardBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel DataContext="{Binding Dsp}" Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VOIDEQ • 3-Band Equalizer" FontWeight="Bold" FontSize="13.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Flat" Click="ResetEqFlat_Click" Padding="8,3" CornerRadius="6" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="2" IsOn="{Binding EqEnabled, Mode=TwoWay}" OffContent="Off" OnContent="On"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Low Shelf (100 Hz)" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding EqLowGainDbText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="-15" Maximum="15" StepFrequency="0.5" Value="{Binding EqLowGainDbDouble, Mode=TwoWay}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mid Presence (1.1 kHz)" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding EqMidGainDbText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="-15" Maximum="15" StepFrequency="0.5" Value="{Binding EqMidGainDbDouble, Mode=TwoWay}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="High Air (8 kHz)" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding EqHighGainDbText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="-15" Maximum="15" StepFrequency="0.5" Value="{Binding EqHighGainDbDouble, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. VoidComp -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource BgCardBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel DataContext="{Binding Dsp}" Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VOIDCOMP • Compressor" FontWeight="Bold" FontSize="13.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Reset" Click="ResetComp_Click" Padding="8,3" CornerRadius="6" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="2" IsOn="{Binding CompEnabled, Mode=TwoWay}" OffContent="Off" OnContent="On"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Threshold" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CompThresholdDbText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="-50" Maximum="0" StepFrequency="1" Value="{Binding CompThresholdDbDouble, Mode=TwoWay}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ratio" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CompRatioText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="16" StepFrequency="0.5" Value="{Binding CompRatioDouble, Mode=TwoWay}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Makeup Gain" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CompMakeupGainDbText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="-6" Maximum="18" StepFrequency="0.5" Value="{Binding CompMakeupGainDbDouble, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. VoidLimiter -->
                    <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource BgCardBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel DataContext="{Binding Dsp}" Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VOIDLIMITER • Brickwall" FontWeight="Bold" FontSize="13.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Reset" Click="ResetLimiter_Click" Padding="8,3" CornerRadius="6" Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="2" IsOn="{Binding LimiterEnabled, Mode=TwoWay}" OffContent="Off" OnContent="On"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Output Ceiling" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LimiterCeilingDbText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Grid>
                            <Slider Minimum="-12" Maximum="-0.1" StepFrequency="0.1" Value="{Binding LimiterCeilingDbDouble, Mode=TwoWay}"/>
                            <TextBlock Text="Prevents clipping on sudden loud peaks before feeding Personal &amp; Stream mixes."
                                       FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- External VST2 / VST3 Plugin Chain -->
                <Border Background="{ThemeResource BgCardBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EXTERNAL VST2 / VST3 PLUGIN INSERT CHAIN" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                <TextBlock Text="Insert installed VST3 (.vst3) or VST2 (.dll) audio effects directly into this channel" FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <ComboBox x:Name="VstPickerCombo" Width="240" DisplayMemberPath="Name"/>
                                <Button Content="+ Add VST" Padding="14,7" CornerRadius="16"
                                        Background="{ThemeResource AccentPrimaryBrush}" Foreground="{ThemeResource AccentTextOnPrimary}" FontWeight="Bold"
                                        Click="AddSelectedVst_Click"/>
                                <Button Content="Browse..." Padding="12,7" CornerRadius="16"
                                        Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}"
                                        Click="BrowseVstFile_Click"/>
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="VstSlotsList" ItemsSource="{Binding VstSlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource BgSidebarBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="28"/>
                                            <Border Grid.Column="1" Background="{ThemeResource AccentPillBgBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Format}" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding PluginName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <TextBlock Text="Mix:" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Slider Width="90" Minimum="0" Maximum="1" StepFrequency="0.02" Value="{Binding WetMixDouble, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <Button Content="🎛️ Open Editor" Tag="{Binding}" Padding="12,6" CornerRadius="14"
                                                        Background="{ThemeResource AccentPrimaryBrush}" Foreground="{ThemeResource AccentTextOnPrimary}" FontWeight="Bold"
                                                        Click="OpenVstEditor_Click"/>
                                                <Button Content="✕" Tag="{Binding}" Width="34" Height="32" CornerRadius="14"
                                                        Background="{ThemeResource BgMutedCellBrush}" Foreground="{ThemeResource BorderMutedCellBrush}" FontWeight="Bold"
                                                        Click="RemoveVstSlot_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Material Design 3 Footer -->
        <Border Grid.Row="2" Background="{ThemeResource BgSidebarBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Reset EQ Flat" Padding="16,7" CornerRadius="16"
                        Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}"
                        Click="ResetEqFlat_Click"/>
                <Button Grid.Column="1" Content="Done" Width="120" Padding="14,7" CornerRadius="18"
                        Background="{ThemeResource AccentPrimaryBrush}" Foreground="{ThemeResource AccentTextOnPrimary}" FontWeight="Bold"
                        Click="Done_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
