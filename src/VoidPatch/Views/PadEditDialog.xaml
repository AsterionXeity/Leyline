<Window
    x:Class="VoidPatch.Views.PadEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configure Soundboard Pad">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgWindowBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18" Spacing="4">
            <TextBlock Text="Soundboard Pad Configuration" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
            <TextBlock Text="Assign audio sample, volume, bus routing, and global hotkey" FontSize="12.5" Foreground="{ThemeResource TextMutedBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Emoji" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBox x:Name="EmojiBox" Text="🔊" TextAlignment="Center" CornerRadius="10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Pad Title" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBox x:Name="NameBox" Text="Sound Effect" CornerRadius="10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Accent Color" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="ColorCombo" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="10">
                            <ComboBoxItem Content="#00E5FF"/>
                            <ComboBoxItem Content="#FF4081"/>
                            <ComboBoxItem Content="#7C4DFF"/>
                            <ComboBoxItem Content="#00E676"/>
                            <ComboBoxItem Content="#FFD740"/>
                            <ComboBoxItem Content="#FF5252"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Audio File (.wav, .mp3, .ogg, .flac, .m4a)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="FilePathBox" CornerRadius="10"/>
                        <Button Grid.Column="1" Content="Browse..." Padding="14,7" CornerRadius="14"
                                Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}"
                                Click="BrowseAudio_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pad Volume" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="VolLabel" Text="90%" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                    </Grid>
                    <Slider x:Name="VolSlider" Minimum="0" Maximum="2.0" StepFrequency="0.02" Value="0.9" ValueChanged="VolSlider_ValueChanged"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Playback Mode" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="ModeCombo" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="10">
                        <ComboBoxItem Content="Stop Toggle (Click to play, click again to stop)"/>
                        <ComboBoxItem Content="One-Shot (Restart from beginning on press)"/>
                        <ComboBoxItem Content="Overlap (Polyphonic rapid trigger)"/>
                        <ComboBoxItem Content="Loop (Repeat continuously until stopped)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="20">
                    <CheckBox x:Name="MonitorCheck" Content="Send to Personal Mix" IsChecked="True"/>
                    <CheckBox x:Name="StreamCheck" Content="Send to Stream Mix" IsChecked="True"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Global Hotkey (Click box and press key combo)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="HotkeyBox" IsReadOnly="True" Text="None" FontWeight="Bold" CornerRadius="10"
                                 KeyDown="HotkeyBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Clear" Padding="14,7" CornerRadius="14"
                                Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}"
                                Click="ClearHotkey_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,18,0,0">
            <Button Content="Cancel" Width="105" Padding="12,7" CornerRadius="18"
                    Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}"
                    Click="Cancel_Click"/>
            <Button Content="Save Pad" Width="125" Padding="12,7" CornerRadius="18"
                    Background="{ThemeResource AccentPrimaryBrush}" Foreground="{ThemeResource AccentTextOnPrimary}" FontWeight="Bold"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
