<Application
    x:Class="VoidPatch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:VoidPatch.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ================================================================== -->
                <!-- GOOGLE MATERIAL DESIGN 3 + WAVE LINK 3.0 EXACT DARK PALETTE        -->
                <!-- ================================================================== -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgWindowBrush" Color="#161618"/>
                    <SolidColorBrush x:Key="BgSidebarBrush" Color="#161618"/>
                    <SolidColorBrush x:Key="BgModalBrush" Color="#1C1C1F"/>
                    <SolidColorBrush x:Key="BgCardBrush" Color="#262629"/>
                    <SolidColorBrush x:Key="BgCardElevatedBrush" Color="#2E2E33"/>
                    <SolidColorBrush x:Key="BgPillBrush" Color="#262629"/>
                    <SolidColorBrush x:Key="BgEmptyCellBrush" Color="#1E1E21"/>
                    <SolidColorBrush x:Key="BgMutedCellBrush" Color="#442222"/>
                    <SolidColorBrush x:Key="BorderMutedCellBrush" Color="#EF5350"/>
                    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282C"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F7"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D1D1D6"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E8E93"/>
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#B6A8FF"/>
                    <SolidColorBrush x:Key="AccentTextOnPrimary" Color="#1A162B"/>
                    <SolidColorBrush x:Key="AccentPillBgBrush" Color="#2B2B30"/>
                    <SolidColorBrush x:Key="SliderTrackBrush" Color="#38383E"/>
                    <SolidColorBrush x:Key="SliderThumbBrush" Color="#B6A8FF"/>
                    <SolidColorBrush x:Key="MeterGreenBrush" Color="#2BD968"/>
                    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#B8000000"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BgWindowBrush" Color="#161618"/>
                    <SolidColorBrush x:Key="BgSidebarBrush" Color="#161618"/>
                    <SolidColorBrush x:Key="BgModalBrush" Color="#1C1C1F"/>
                    <SolidColorBrush x:Key="BgCardBrush" Color="#262629"/>
                    <SolidColorBrush x:Key="BgCardElevatedBrush" Color="#2E2E33"/>
                    <SolidColorBrush x:Key="BgPillBrush" Color="#262629"/>
                    <SolidColorBrush x:Key="BgEmptyCellBrush" Color="#1E1E21"/>
                    <SolidColorBrush x:Key="BgMutedCellBrush" Color="#442222"/>
                    <SolidColorBrush x:Key="BorderMutedCellBrush" Color="#EF5350"/>
                    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282C"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F7"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D1D1D6"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E8E93"/>
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#B6A8FF"/>
                    <SolidColorBrush x:Key="AccentTextOnPrimary" Color="#1A162B"/>
                    <SolidColorBrush x:Key="AccentPillBgBrush" Color="#2B2B30"/>
                    <SolidColorBrush x:Key="SliderTrackBrush" Color="#38383E"/>
                    <SolidColorBrush x:Key="SliderThumbBrush" Color="#B6A8FF"/>
                    <SolidColorBrush x:Key="MeterGreenBrush" Color="#2BD968"/>
                    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#B8000000"/>
                </ResourceDictionary>

                <!-- ================================================================== -->
                <!-- GOOGLE MATERIAL DESIGN 3 — LIGHT THEME                             -->
                <!-- ================================================================== -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgWindowBrush" Color="#F5F6FA"/>
                    <SolidColorBrush x:Key="BgSidebarBrush" Color="#ECEEF5"/>
                    <SolidColorBrush x:Key="BgModalBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BgCardElevatedBrush" Color="#E3E6F0"/>
                    <SolidColorBrush x:Key="BgPillBrush" Color="#E6E8F2"/>
                    <SolidColorBrush x:Key="BgEmptyCellBrush" Color="#EAECEF"/>
                    <SolidColorBrush x:Key="BgMutedCellBrush" Color="#FCE8E6"/>
                    <SolidColorBrush x:Key="BorderMutedCellBrush" Color="#D93025"/>
                    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D5D9E6"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#191C20"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#44474F"/>
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#74777F"/>
                    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4355B9"/>
                    <SolidColorBrush x:Key="AccentTextOnPrimary" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentPillBgBrush" Color="#DCE1FF"/>
                    <SolidColorBrush x:Key="SliderTrackBrush" Color="#CBD0E2"/>
                    <SolidColorBrush x:Key="SliderThumbBrush" Color="#4355B9"/>
                    <SolidColorBrush x:Key="MeterGreenBrush" Color="#1E8E3E"/>
                    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#77000000"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Value Converters -->
            <views:BoolToVisConverter x:Key="BoolToVis"/>
            <views:HexToBrushConverter x:Key="HexToBrush"/>
            <views:MixCellBgConverter x:Key="MixCellBg"/>
            <views:MixMutedCellBgConverter x:Key="MixMutedCellBg"/>
            <views:MixMutedBorderBrushConverter x:Key="MixMutedBorder"/>
            <views:BoolToOpacityConverter x:Key="BoolToOpacity"/>
            <views:ActiveFxBrushConverter x:Key="ActiveFxBrush"/>
            <views:MuteIconConverter x:Key="MuteIcon"/>
            <views:MuteToggleBgConverter x:Key="MuteToggleBg"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
