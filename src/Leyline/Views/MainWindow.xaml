                                <Border Background="{ThemeResource BgCardBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
