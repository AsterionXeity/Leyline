                                                    <CheckBox Grid.Column="0" IsChecked="{Binding CompEnabled, Mode=TwoWay}" MinWidth="26" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="VoidComp • Studio Compressor" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="#282830" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0">
