                                <FontIcon Glyph="&#xE74D;" FontSize="12.5"/>
                                <TextBlock Text="Remove channel"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Content="Close window" Style="{StaticResource MatPrimaryBtn}"
                                Click="CloseChannelConfigModal_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

