                                                    <Border Grid.Column="2" Background="#282830" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="BUILT-IN VST" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                                    </Border>
                                                    <Button Grid.Column="3" Content="Reset" Click="ResetModalLimiter_Click" Style="{StaticResource MatBtn}" Padding="6,2" FontSize="10"/>
                                                </Grid>

                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="Output Ceiling" FontSize="10.5" Foreground="{ThemeResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding LimiterCeilingDbText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider Minimum="-12" Maximum="-0.1" StepFrequency="0.1" Value="{Binding LimiterCeilingDbDouble, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- External VST2 / VST3 Plugin Chain -->
                                        <TextBlock Text="External VST2 / VST3 Plugin Chain" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}" Margin="0,6,0,2"/>
                                        <Grid ColumnSpacing="6" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ModalVstPickerCombo" Grid.Column="0" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1" Content="+ Add VST" Style="{StaticResource MatPrimaryBtn}" Padding="10,5"
                                                    Click="AddVstFromModal_Click"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding VstSlots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1A1A1E" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" MinWidth="28" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding PluginName}" FontWeight="SemiBold" FontSize="12.5"
                                                                       Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                                <Button Content="Editor" Tag="{Binding}" Style="{StaticResource MatBtn}" Padding="8,3" FontSize="11"
                                                                        Click="OpenModalVstEditor_Click"/>
                                                                <Button Tag="{Binding}" Background="Transparent" Foreground="#EF5350" BorderThickness="0" Padding="6,4"
                                                                        Click="RemoveModalVstSlot_Click">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Footer: "Remove channel" (Bottom-Left) + "Close window" (Bottom-Right) (Screenshot 3) -->
                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
