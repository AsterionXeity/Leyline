                                            <StackPanel>
                                                <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Virtual instruments" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <FontIcon Grid.Column="1" Glyph="&#xE70E;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Margin="18,14">
                                                    <TextBlock Text="These plugins are instruments and cannot be used as effects."
                                                               FontSize="12.5" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,14"/>
                                                    <ItemsControl ItemsSource="{Binding VirtualInstrumentPlugins}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="1" Content="{Binding OverrideButtonText}"
                                                                            Style="{StaticResource MatBtn}" Padding="10,4" FontSize="11.5"
                                                                            Tag="{Binding}" Click="ToggleAllowBlockedPlugin_Click"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="ScannedPluginsScroll" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ScannedEffectPlugins}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{ThemeResource BgCardBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{ThemeResource BgEmptyCellBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Format}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- SETTINGS TAB 3: BACKUP & RESTORE -->
                            <StackPanel x:Name="SettingsRestorePanel" Visibility="Collapsed">
                                <TextBlock Text="Backup, Import &amp; Restore" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <Border Background="{ThemeResource BgCardBrush}" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Backup &amp; Import Configuration" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Save a complete backup of your Leyline channels, mixes, app assignments, DSP/VST chains, and soundboard pads, or import a previously saved backup file."
                                                   FontSize="12.5" Foreground="{ThemeResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ConfigFilePathText}" FontSize="11" Foreground="{ThemeResource AccentPrimaryBrush}" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Content="Backup Configuration (.json)..." Style="{StaticResource MatPrimaryBtn}"
                                                    Click="BackupConfiguration_Click"/>
                                            <Button Content="Import Configuration (.json)..." Style="{StaticResource MatBtn}"
                                                    Click="ImportConfiguration_Click"/>
                                            <Button Content="Open Config Folder" Style="{StaticResource MatBtn}"
                                                    Click="OpenConfigFolder_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{ThemeResource BgCardBrush}" CornerRadius="8" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Reset Channel Matrix Layout" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Restores the default System channel configuration (all other channels can be added as needed)."
                                                   FontSize="12.5" Foreground="{ThemeResource TextMutedBrush}" Margin="0,0,0,14"/>
                                        <Button Content="Restore Default Channel (System Only)" Style="{StaticResource MatBtn}" HorizontalAlignment="Left"
                                                Command="{Binding RestoreDefaultChannelsCommand}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                        <TextBlock Text="Leyline Audio Router &amp; Mixer • Google Material Design 3 • WinUI 3"
                                   FontSize="12" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================== -->
        <!-- PRE-MAIN-SCREEN DRIVER INSTALLATION PROMPT OVERLAY                 -->
        <!-- ================================================================== -->
        <Grid x:Name="StartupDriverPromptOverlay" Grid.Row="1" Background="{ThemeResource BgWindowBrush}" Visibility="Visible">
            <Border Width="640" Background="{ThemeResource BgModalBrush}"
                    BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14"
                    Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <!-- Header Icon & Title -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="12" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00E676" Offset="0"/>
                                    <GradientStop Color="#00B0FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="〰" FontSize="26" FontWeight="Bold" Foreground="#0B0C10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Leyline Virtual Audio Driver Setup" FontSize="21" FontWeight="Bold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Text="Required for standalone virtual audio routing buses" FontSize="12.5"
                                       Foreground="{ThemeResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Leyline routes audio through its own virtual audio driver: one virtual cable per channel (System, Game, Browser, Music, Voice Chat) plus Stream Mix for OBS and Microphone for Discord. Install it now, or update it when a new version of Leyline includes a newer driver."
                               FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"/>

                    <!-- Live Driver Status Card -->
                    <Border Background="{ThemeResource BgCardBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="16,14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="CURRENT DRIVER STATUS" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            <TextBlock Text="{Binding DriverStatusText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="• Cables appear in Windows as e.g. System (Leyline Virtual Audio) and show as Disconnected until a channel uses them"
                                       FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}"/>
                            <TextBlock Text="• Direct Per-App WASAPI Loopback Capture also works even if you skip driver installation"
                                       FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Spacing="10" Margin="0,4,0,0">
                        <Button HorizontalAlignment="Stretch" Padding="16,11" Style="{StaticResource MatPrimaryBtn}"
                                Click="StartupInstallDriverAndContinue_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DriverActionText}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Continue to Main Screen →" HorizontalAlignment="Stretch" Padding="14,9"
                                    Style="{StaticResource MatBtn}" Click="StartupContinueToMainScreen_Click"/>
                            <Button Grid.Column="1" Content="Uninstall Driver" Padding="14,9"
                                    Style="{StaticResource MatBtn}" Command="{Binding RestoreDriverCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
