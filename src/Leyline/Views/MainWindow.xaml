                                                        <Slider Minimum="-50" Maximum="0" StepFrequency="1" Value="{Binding CompThresholdDbDouble, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <Grid>
                                                            <TextBlock Text="Ratio" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding CompRatioText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Minimum="1" Maximum="16" StepFrequency="0.5" Value="{Binding CompRatioDouble, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Grid>
                                                            <TextBlock Text="Makeup" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding CompMakeupGainDbText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Minimum="-6" Maximum="18" StepFrequency="0.5" Value="{Binding CompMakeupGainDbDouble, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 4. VoidLimiter (Built-in Brickwall Limiter VST) -->
                                        <Border Background="#1A1A1E" CornerRadius="6" Padding="10,8" DataContext="{Binding Dsp}">
                                            <StackPanel Spacing="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
