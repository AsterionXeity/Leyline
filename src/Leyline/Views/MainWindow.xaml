<Window
    x:Class="Leyline.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Leyline.Views"
    Title="Leyline">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgWindowBrush}">
        <Grid.Resources>
            <!-- Flat Tonal Card Button -->
            <Style x:Key="MatBtn" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource BgCardBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Primary Filled Lavender Button ("Close window" in Screenshot 3) -->
            <Style x:Key="MatPrimaryBtn" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentPrimaryBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentTextOnPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Danger / Remove Channel Button (Bottom-Left of Modal in Screenshot 3) -->
            <Style x:Key="MatDangerBtn" TargetType="Button">
                <Setter Property="Background" Value="#2A1E20"/>
                <Setter Property="Foreground" Value="#EF5350"/>
                <Setter Property="BorderBrush" Value="#4A282B"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>

            <!-- Left Navigation Rail Button -->
            <Style x:Key="NavItemBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="8,1"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <!-- Active Left Navigation Rail Button (Dark rounded box + Left Lavender Indicator) -->
            <Style x:Key="NavItemActiveBtn" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentPillBgBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource AccentPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="8,1"/>
                <Setter Property="Padding" Value="10,9"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Popover Menu Item Button (Screenshot 4) -->
            <Style x:Key="PopoverItemBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="8,8"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================== -->
        <!-- CUSTOM INTEGRATED TITLE BAR (MATCHING SCREENSHOTS 1, 2, 5)          -->
        <!-- ================================================================== -->
        <Grid Grid.Row="0" Background="{ThemeResource BgWindowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="6">
                <Button Width="28" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="ToggleSidebar_Click" ToolTipService.ToolTip="Toggle Navigation Sidebar">
                    <FontIcon Glyph="&#xE700;" FontSize="12.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                </Button>

                <Border Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center" Margin="2,0,4,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00E676" Offset="0"/>
                            <GradientStop Color="#00B0FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="〰" FontSize="10" FontWeight="Bold" Foreground="#0B0C10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>

                <TextBlock Text="Leyline" FontSize="12" FontWeight="Medium"
                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Native Drag Region for Window Title Bar -->
            <Border x:Name="CustomTitleBarDragRegion" Grid.Column="1" Background="Transparent"/>
        </Grid>

        <!-- ================================================================== -->
        <!-- MAIN FULL WORKSPACE: LEFT NAVIGATION SIDEBAR + RIGHT CONTENT       -->
        <!-- ================================================================== -->
        <Grid x:Name="FullModeRootGrid" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT NAVIGATION RAIL ==================== -->
            <Border x:Name="LeftSidebarBorder" Grid.Column="0"
                    Background="{ThemeResource BgSidebarBrush}"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Groups -->
                    <StackPanel Grid.Row="0" Margin="0,10,0,6">
                        <TextBlock Text="Leyline devices" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextMutedBrush}" Margin="18,0,16,6"/>
                        <Button Style="{StaticResource NavItemBtn}" Click="OpenDriverSettings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE946;" FontSize="13.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <TextBlock Text="Connect a device" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{ThemeResource BorderSubtleBrush}" Margin="12,12"/>

                        <TextBlock Text="Mixes &amp; effects" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextMutedBrush}" Margin="18,0,16,6"/>

                        <Button x:Name="NavMixesBtn" Style="{StaticResource NavItemActiveBtn}" Click="NavMixes_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9E9;" FontSize="13.5"/>
                                <TextBlock Text="Mixes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavAudioFlowBtn" Style="{StaticResource NavItemBtn}" Click="NavAudioFlow_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xEC27;" FontSize="13.5"/>
                                <TextBlock Text="Audio Flow" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSoundboardBtn" Style="{StaticResource NavItemBtn}" Click="NavSoundboard_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="〰" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="1,0,1,0"/>
                                <TextBlock Text="Soundboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Sidebar Footer (Matches Screenshot 2 & 5) -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <Border Padding="16,8" Margin="4,0,4,4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8E1;" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Beta version" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Share your feedback" FontSize="11.5" TextDecorations="Underline"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               ToolTipService.ToolTip="{Binding StatusBannerText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="{ThemeResource BorderSubtleBrush}" Margin="12,6"/>

                        <Button Style="{StaticResource NavItemBtn}" Click="OpenPluginsSettings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xEA86;" FontSize="13.5"/>
                                <TextBlock Text="Marketplace" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavItemBtn}" Click="OpenSettings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="13.5"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== RIGHT WORKSPACE ==================== -->
            <Grid Grid.Column="1">

                <!-- ****************************************************************** -->
                <!-- VIEW 0: MIXES (EXACT 2D MATRIX VIEW FROM SCREENSHOTS 1, 2, 5)      -->
                <!-- ****************************************************************** -->
                <Grid x:Name="MixesView" Visibility="Visible" Margin="24,14,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Monitoring Header Bar: "Mixes" + "Listening to [Mix v]" + "on [Output Device v]" + Share + Compact -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Mixes" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Dropdown 1: Listening to [Selected Mix] -->
                            <Border Background="{ThemeResource BgPillBrush}" CornerRadius="6" Padding="10,2" Height="36">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Listening to" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding MixBuses}"
                                              SelectedIndex="{Binding ListeningMixIndex, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              Background="Transparent" BorderThickness="0"
                                              MinWidth="135" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Dropdown 2: on [Monitoring Output Device] -->
                            <Border Background="{ThemeResource BgPillBrush}" CornerRadius="6" Padding="10,2" Height="36">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="on" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding RenderDevicesWithNone}"
                                              SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              Background="Transparent" BorderThickness="0"
                                              Width="220" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Share / Record Stream Mix Button -->
                            <Button Width="34" Height="32" Padding="0" Style="{StaticResource MatBtn}"
                                    Command="{Binding ToggleRecordStreamCommand}"
                                    ToolTipService.ToolTip="Record Stream Mix to WAV file">
                                <FontIcon Glyph="&#xE72D;" FontSize="13"/>
                            </Button>

                            <!-- Compact Mini-Mixer Mode Button -->
                            <Button Width="34" Height="32" Padding="0" Style="{StaticResource MatBtn}"
                                    Click="ToggleCompactWindow_Click"
                                    ToolTipService.ToolTip="Switch to Compact Mini-Mixer View">
                                <FontIcon Glyph="&#xE740;" FontSize="12.5"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable 2D Matrix Grid -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- MATRIX COLUMN HEADERS ROW (Personal Mix, Stream Mix, Discord Record Mix, Mic Rec Mix, +) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="288"/>
                                    <ColumnDefinition Width="216"/>
                                    <ColumnDefinition Width="216"/>
                                    <ColumnDefinition Width="216"/>
                                    <ColumnDefinition Width="216"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"/>

                                <!-- Column 1: Personal Mix -->
                                <Border Grid.Column="1" Height="52" Background="{ThemeResource BgCardBrush}" CornerRadius="6" Margin="4,0" Padding="12,0"
                                        PointerPressed="SelectListeningMix0_PointerPressed" RightTapped="OpenMonitorMasterFx_RightTapped"
                                        ToolTipService.ToolTip="Left-click to Monitor Personal Mix • Right-click for Master DSP">
                                    <Grid>
                                        <Border Width="16" Height="2.5" Background="{ThemeResource AccentPrimaryBrush}" CornerRadius="1.2"
                                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                                Visibility="{Binding MixBuses[0].IsListeningTarget, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#F2F2F7">
                                                <FontIcon Glyph="&#xE7F6;" FontSize="14" Foreground="#141418"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Personal Mix" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                <TextBlock Text="1 output" FontSize="10.5" Foreground="{ThemeResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Width="18" Height="2.5" CornerRadius="1.2" Background="{ThemeResource MeterGreenBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Stream Mix -->
                                <Border Grid.Column="2" Height="52" Background="{ThemeResource BgCardBrush}" CornerRadius="6" Margin="4,0" Padding="12,0"
                                        PointerPressed="SelectListeningMix1_PointerPressed"
                                        ToolTipService.ToolTip="Left-click to Monitor Stream Mix">
                                    <Grid>
                                        <Border Width="16" Height="2.5" Background="{ThemeResource AccentPrimaryBrush}" CornerRadius="1.2"
                                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                                Visibility="{Binding MixBuses[1].IsListeningTarget, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#F2F2F7">
                                                <FontIcon Glyph="&#xE701;" FontSize="14" Foreground="#141418"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Stream Mix" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Column 3: Discord Record Mix -->
                                <Border Grid.Column="3" Height="52" Background="{ThemeResource BgCardBrush}" CornerRadius="6" Margin="4,0" Padding="12,0"
                                        PointerPressed="SelectListeningMix2_PointerPressed"
                                        ToolTipService.ToolTip="Left-click to Monitor Discord Record Mix">
                                    <Grid>
                                        <Border Width="16" Height="2.5" Background="{ThemeResource AccentPrimaryBrush}" CornerRadius="1.2"
                                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                                Visibility="{Binding MixBuses[2].IsListeningTarget, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#F2F2F7">
                                                <FontIcon Glyph="&#xE716;" FontSize="13.5" Foreground="#141418"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Discord Record Mix" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Column 4: Mic Rec Mix -->
                                <Border Grid.Column="4" Height="52" Background="{ThemeResource BgCardBrush}" CornerRadius="6" Margin="4,0" Padding="12,0"
                                        PointerPressed="SelectListeningMix3_PointerPressed"
                                        ToolTipService.ToolTip="Left-click to Monitor Mic Rec Mix">
                                    <Grid>
                                        <Border Width="16" Height="2.5" Background="{ThemeResource AccentPrimaryBrush}" CornerRadius="1.2"
                                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                                Visibility="{Binding MixBuses[3].IsListeningTarget, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#F2F2F7">
                                                <FontIcon Glyph="&#xE7C8;" FontSize="14" Foreground="#141418"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Mic Rec Mix" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- + Button to Create New Mix Column -->
                                <Button Grid.Column="5" Content="+" Width="30" Height="52" Margin="4,0,0,0" Padding="0"
                                        Style="{StaticResource MatBtn}" FontSize="16" FontWeight="Normal"
                                        Command="{Binding AddNewMixBusCommand}" ToolTipService.ToolTip="Create new Output Mix"/>
                            </Grid>

                            <!-- MATRIX CHANNEL ROWS (DRAG-AND-DROP REORDERABLE + CLICK TO OPEN CHANNEL CONFIG MODAL) -->
                            <ItemsControl ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8" Height="54"
                                              AllowDrop="True"
                                              Tag="{Binding}"
                                              DragOver="ChannelRow_DragOver"
                                              Drop="ChannelRow_Drop">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="288"/>
                                                <ColumnDefinition Width="216"/>
                                                <ColumnDefinition Width="216"/>
                                                <ColumnDefinition Width="216"/>
                                                <ColumnDefinition Width="216"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- COL 0: INPUT CHANNEL HEADER CARD (EXACT SCREENSHOT 1 & 2 LAYOUT) -->
                                            <Border Grid.Column="0"
                                                    Background="{ThemeResource BgCardBrush}"
                                                    CornerRadius="6"
                                                    Margin="0,0,4,0"
                                                    Padding="10,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Colored / Composite Icon Tile (Click opens Channel Config Modal, Drag reorders row) -->
                                                    <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"
                                                          CanDrag="True" Tag="{Binding}"
                                                          DragStarting="ChannelRow_DragStarting"
                                                          PointerReleased="OpenChannelConfig_PointerReleased"
                                                          ToolTipService.ToolTip="Click to configure channel • Drag to reorder">
                                                        <Border Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}" CornerRadius="6">
                                                            <FontIcon Glyph="{Binding GlyphIcon}" FontSize="15"
                                                                      Foreground="{Binding IconForegroundHex, Converter={StaticResource HexToBrush}}"/>
                                                        </Border>
                                                        <Border Background="#42FFFFFF" CornerRadius="4" Padding="3,0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"
                                                                Visibility="{Binding HasRoutedApps, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding RoutedAppBadge}" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Channel Title + Subtle Inline Microphone Device Subtitle -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Tag="{Binding}" PointerReleased="OpenChannelConfig_PointerReleased"
                                                                   ToolTipService.ToolTip="Click to configure channel"/>
                                                        <ComboBox Loaded="InlineMicCombo_Loaded"
                                                                  SelectionChanged="ChannelDeviceCombo_SelectionChanged"
                                                                  DisplayMemberPath="Name"
                                                                  Tag="{Binding}"
                                                                  Visibility="{Binding IsHardwareInput, Converter={StaticResource BoolToVis}}"
                                                                  Background="Transparent" BorderThickness="0"
                                                                  Foreground="{ThemeResource TextSecondaryBrush}"
                                                                  FontSize="11" MinHeight="24" Padding="2,0" Margin="0,1,0,0"
                                                                  HorizontalAlignment="Stretch"
                                                                  ToolTipService.ToolTip="Select Microphone Input Device (or None)"/>
                                                    </StackPanel>

                                                    <!-- Master Mute Speaker Button -->
                                                    <ToggleButton Grid.Column="2" Width="28" Height="26" Padding="0" CornerRadius="5"
                                                                  Background="{Binding IsInputMuted, Converter={StaticResource MuteToggleBg}}"
                                                                  BorderBrush="{Binding IsInputMuted, Converter={StaticResource MixMutedBorder}}"
                                                                  BorderThickness="1"
                                                                  IsChecked="{Binding IsInputMuted, Mode=TwoWay}" Margin="0,0,6,0"
                                                                  ToolTipService.ToolTip="Mute Channel Input">
                                                        <FontIcon Glyph="{Binding IsInputMuted, Converter={StaticResource MuteIcon}}" FontSize="12.5"
                                                                  Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                    </ToggleButton>

                                                    <!-- Master Volume Pill Slider with Integrated Stereo Green Meter -->
                                                    <views:MeterPillSlider Grid.Column="3"
                                                                           Value="{Binding InputVolumeDouble, Mode=TwoWay}"
                                                                           MeterLeft="{Binding PeakLeftDouble, Mode=OneWay}"
                                                                           MeterRight="{Binding PeakRightDouble, Mode=OneWay}"
                                                                           IsMutedTheme="{Binding IsInputMuted, Mode=OneWay}"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                    <!-- Audio Effects (Waveform) Button -->
                                                    <Button Grid.Column="4" Tag="{Binding}" Click="OpenChannelEffects_Click"
                                                            Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="5"
                                                            ToolTipService.ToolTip="{Binding FxSummaryText}">
                                                        <TextBlock Text="〰" FontSize="13.5" FontWeight="Bold"
                                                                   Foreground="{Binding HasActiveFx, Converter={StaticResource ActiveFxBrush}}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- COL 1: PERSONAL MIX ROUTING CELL -->
                                            <Border Grid.Column="1" DataContext="{Binding PersonalMix}"
                                                    Background="{Binding CellStateKey, Converter={StaticResource MixCellBg}}"
                                                    CornerRadius="6"
                                                    Margin="4,0" Padding="14,0" Tag="{Binding}"
                                                    PointerPressed="EmptyMixCell_PointerPressed" RightTapped="DisableMixCell_RightTapped"
                                                    ToolTipService.ToolTip="Left-click empty cell to enable • Right-click to disable mix send">
                                                <Grid Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="0" Width="28" Height="26" Padding="0" CornerRadius="5"
                                                                  Background="{Binding IsMuted, Converter={StaticResource MuteToggleBg}}"
                                                                  BorderBrush="{Binding IsMuted, Converter={StaticResource MixMutedBorder}}"
                                                                  BorderThickness="1"
                                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,10,0">
                                                        <FontIcon Glyph="{Binding IsMuted, Converter={StaticResource MuteIcon}}" FontSize="12.5"
                                                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                    </ToggleButton>
                                                    <views:MeterPillSlider Grid.Column="1"
                                                                           Value="{Binding VolumeDouble, Mode=TwoWay}"
                                                                           MeterLeft="{Binding CurrentMeterL, Mode=OneWay}"
                                                                           MeterRight="{Binding CurrentMeterR, Mode=OneWay}"
                                                                           IsMutedTheme="{Binding IsMuted, Mode=OneWay}"
                                                                           VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- COL 2: STREAM MIX ROUTING CELL -->
                                            <Border Grid.Column="2" DataContext="{Binding StreamMix}"
                                                    Background="{Binding CellStateKey, Converter={StaticResource MixCellBg}}"
                                                    CornerRadius="6"
                                                    Margin="4,0" Padding="14,0" Tag="{Binding}"
                                                    PointerPressed="EmptyMixCell_PointerPressed" RightTapped="DisableMixCell_RightTapped"
                                                    ToolTipService.ToolTip="Left-click empty cell to enable • Right-click to disable mix send">
                                                <Grid Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="0" Width="28" Height="26" Padding="0" CornerRadius="5"
                                                                  Background="{Binding IsMuted, Converter={StaticResource MuteToggleBg}}"
                                                                  BorderBrush="{Binding IsMuted, Converter={StaticResource MixMutedBorder}}"
                                                                  BorderThickness="1"
                                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,10,0">
                                                        <FontIcon Glyph="{Binding IsMuted, Converter={StaticResource MuteIcon}}" FontSize="12.5"
                                                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                    </ToggleButton>
                                                    <views:MeterPillSlider Grid.Column="1"
                                                                           Value="{Binding VolumeDouble, Mode=TwoWay}"
                                                                           MeterLeft="{Binding CurrentMeterL, Mode=OneWay}"
                                                                           MeterRight="{Binding CurrentMeterR, Mode=OneWay}"
                                                                           IsMutedTheme="{Binding IsMuted, Mode=OneWay}"
                                                                           VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- COL 3: DISCORD RECORD MIX ROUTING CELL -->
                                            <Border Grid.Column="3" DataContext="{Binding DiscordMix}"
                                                    Background="{Binding CellStateKey, Converter={StaticResource MixCellBg}}"
                                                    CornerRadius="6"
                                                    Margin="4,0" Padding="14,0" Tag="{Binding}"
                                                    PointerPressed="EmptyMixCell_PointerPressed" RightTapped="DisableMixCell_RightTapped"
                                                    ToolTipService.ToolTip="Left-click empty cell to enable • Right-click to disable mix send">
                                                <Grid Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="0" Width="28" Height="26" Padding="0" CornerRadius="5"
                                                                  Background="{Binding IsMuted, Converter={StaticResource MuteToggleBg}}"
                                                                  BorderBrush="{Binding IsMuted, Converter={StaticResource MixMutedBorder}}"
                                                                  BorderThickness="1"
                                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,10,0">
                                                        <FontIcon Glyph="{Binding IsMuted, Converter={StaticResource MuteIcon}}" FontSize="12.5"
                                                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                    </ToggleButton>
                                                    <views:MeterPillSlider Grid.Column="1"
                                                                           Value="{Binding VolumeDouble, Mode=TwoWay}"
                                                                           MeterLeft="{Binding CurrentMeterL, Mode=OneWay}"
                                                                           MeterRight="{Binding CurrentMeterR, Mode=OneWay}"
                                                                           IsMutedTheme="{Binding IsMuted, Mode=OneWay}"
                                                                           VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- COL 4: MIC REC MIX ROUTING CELL -->
                                            <Border Grid.Column="4" DataContext="{Binding MicRecMix}"
                                                    Background="{Binding CellStateKey, Converter={StaticResource MixCellBg}}"
                                                    CornerRadius="6"
                                                    Margin="4,0" Padding="14,0" Tag="{Binding}"
                                                    PointerPressed="EmptyMixCell_PointerPressed" RightTapped="DisableMixCell_RightTapped"
                                                    ToolTipService.ToolTip="Left-click empty cell to enable • Right-click to disable mix send">
                                                <Grid Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="0" Width="28" Height="26" Padding="0" CornerRadius="5"
                                                                  Background="{Binding IsMuted, Converter={StaticResource MuteToggleBg}}"
                                                                  BorderBrush="{Binding IsMuted, Converter={StaticResource MixMutedBorder}}"
                                                                  BorderThickness="1"
                                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,10,0">
                                                        <FontIcon Glyph="{Binding IsMuted, Converter={StaticResource MuteIcon}}" FontSize="12.5"
                                                                  Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                    </ToggleButton>
                                                    <views:MeterPillSlider Grid.Column="1"
                                                                           Value="{Binding VolumeDouble, Mode=TwoWay}"
                                                                           MeterLeft="{Binding CurrentMeterL, Mode=OneWay}"
                                                                           MeterRight="{Binding CurrentMeterR, Mode=OneWay}"
                                                                           IsMutedTheme="{Binding IsMuted, Mode=OneWay}"
                                                                           VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- + CREATE CHANNEL CARD BUTTON WITH POPOVER FLYOUT (EXACT SCREENSHOT 4 & 5) -->
                            <Grid HorizontalAlignment="Left" Width="284" Margin="0,0,0,16">
                                <Button x:Name="CreateChannelBtn" Height="52" HorizontalAlignment="Stretch"
                                        Background="#202023" BorderThickness="0" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="+" FontSize="15" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        <TextBlock Text="Create channel" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="CreateChannelFlyout" Placement="TopEdgeAlignedLeft" Opening="CreateChannelFlyout_Opening">
                                            <Border Width="284" Height="450"
                                                    Background="{ThemeResource BgPopoverBrush}"
                                                    BorderBrush="#323238"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Margin="-12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Search Input Box with Lavender Bottom Focus Bar (Screenshot 4) -->
                                                    <Border Grid.Row="0" Background="#18181B" CornerRadius="6" Margin="10,10,10,6"
                                                            BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="1,1,1,2" Padding="10,4">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12.5" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding CreateChannelSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     PlaceholderText="Search"
                                                                     Background="Transparent" Foreground="{ThemeResource TextPrimaryBrush}" BorderThickness="0"
                                                                     Padding="0,2" FontSize="13"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Scrollable Categories: Input devices, Wave Link / Leyline, Active apps, Suggested apps -->
                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0">
                                                        <StackPanel>
                                                            <!-- 1. Input devices -->
                                                            <TextBlock Text="Input devices" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" Margin="6,8,0,6"/>
                                                            <Border Height="1" Background="#2E2E34" Margin="4,0,4,6"/>
                                                            <ItemsControl ItemsSource="{Binding FilteredPopoverInputDevices}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource PopoverItemBtn}"
                                                                                Tag="{Binding}"
                                                                                Click="CreateChannelFromInputDevice_Click">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Border Width="20" Height="20" Background="#448AFF" CornerRadius="4">
                                                                                    <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="#FFFFFF"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis" Width="212" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- 2. Built-in & Preset Channels (Soundboard, Browser, Game, Music, Voice Chat, OBS/Stream, Microphone, System) -->
                                                            <TextBlock Text="Leyline" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" Margin="6,12,0,6"/>
                                                            <Border Height="1" Background="#2E2E34" Margin="4,0,4,6"/>
                                                            <Button Style="{StaticResource PopoverItemBtn}" Click="CreateSoundboardChannel_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Border Width="20" Height="20" Background="#FF7043" CornerRadius="4">
                                                                        <TextBlock Text="〰" FontSize="11" FontWeight="Bold" Foreground="#141418" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="Soundboard" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource PopoverItemBtn}" Tag="Browser" Click="CreatePresetChannel_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Border Width="20" Height="20" Background="#9C27B0" CornerRadius="4">
                                                                        <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="#FFFFFF"/>
                                                                    </Border>
                                                                    <TextBlock Text="Browser" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource PopoverItemBtn}" Tag="Game" Click="CreatePresetChannel_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Border Width="20" Height="20" Background="#8D3B3B" CornerRadius="4">
                                                                        <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#FFFFFF"/>
                                                                    </Border>
                                                                    <TextBlock Text="Game" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource PopoverItemBtn}" Tag="Music" Click="CreatePresetChannel_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Border Width="20" Height="20" Background="#AB47BC" CornerRadius="4">
                                                                        <FontIcon Glyph="&#xEC4F;" FontSize="11" Foreground="#FFFFFF"/>
                                                                    </Border>
                                                                    <TextBlock Text="Music" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource PopoverItemBtn}" Tag="Voice Chat" Click="CreatePresetChannel_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Border Width="20" Height="20" Background="#FBC02D" CornerRadius="4">
                                                                        <FontIcon Glyph="&#xE8BD;" FontSize="11" Foreground="#141418"/>
                                                                    </Border>
                                                                    <TextBlock Text="Voice Chat" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource PopoverItemBtn}" Tag="OBS/Stream" Click="CreatePresetChannel_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Border Width="20" Height="20" Background="#37474F" CornerRadius="4">
                                                                        <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="#FFFFFF"/>
                                                                    </Border>
                                                                    <TextBlock Text="OBS/Stream" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource PopoverItemBtn}" Tag="Microphone" Click="CreatePresetChannel_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Border Width="20" Height="20" Background="#448AFF" CornerRadius="4">
                                                                        <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="#FFFFFF"/>
                                                                    </Border>
                                                                    <TextBlock Text="Microphone" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource PopoverItemBtn}" Tag="System" Click="CreatePresetChannel_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <Border Width="20" Height="20" Background="#29B6F6" CornerRadius="4">
                                                                        <FontIcon Glyph="&#xE770;" FontSize="11" Foreground="#141418"/>
                                                                    </Border>
                                                                    <TextBlock Text="System" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- 3. Active apps -->
                                                            <TextBlock Text="Active apps" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" Margin="6,12,0,6"/>
                                                            <Border Height="1" Background="#2E2E34" Margin="4,0,4,6"/>
                                                            <ItemsControl ItemsSource="{Binding FilteredPopoverActiveApps}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource PopoverItemBtn}"
                                                                                Tag="{Binding}"
                                                                                Click="CreateChannelFromActiveApp_Click">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Border Width="20" Height="20" Background="#2E3244" CornerRadius="4">
                                                                                    <FontIcon Glyph="&#xE737;" FontSize="11" Foreground="#B6A8FF"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis" Width="212" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- 4. Suggested apps -->
                                                            <TextBlock Text="Suggested apps" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" Margin="6,12,0,6"/>
                                                            <Border Height="1" Background="#2E2E34" Margin="4,0,4,6"/>
                                                            <ItemsControl ItemsSource="{Binding FilteredPopoverSuggestedApps}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource PopoverItemBtn}"
                                                                                Tag="{Binding}"
                                                                                Click="CreateChannelFromSuggestedApp_Click">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Border Width="20" Height="20" Background="#3A2830" CornerRadius="4">
                                                                                    <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#F28B82"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding}" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"
                                                                                           TextTrimming="CharacterEllipsis" Width="212" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>

                                                    <!-- Sticky Footer: Add empty channel › -->
                                                    <Border Grid.Row="2" BorderBrush="#2E2E34" BorderThickness="0,1,0,0" Padding="8,6">
                                                        <Button Style="{StaticResource PopoverItemBtn}" Click="CreateEmptyChannel_Click">
                                                            <Grid Width="248">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Add empty channel" FontSize="13" FontWeight="Medium"
                                                                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12"
                                                                          Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Floating Bottom-Right Quick Help / Theme Toggle Button (Matches Screenshot 2 & 5) -->
                    <Button Grid.Row="1" Width="38" Height="32" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                            Background="{ThemeResource BgCardBrush}" BorderThickness="0" CornerRadius="6"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTipService.ToolTip="{Binding ThemeButtonText}">
                        <FontIcon Glyph="&#xE7BE;" FontSize="13.5" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- ****************************************************************** -->
                <!-- VIEW 1: AUDIO FLOW (PROGRAM -> CHANNEL -> MIX DIAGRAM)             -->
                <!-- ****************************************************************** -->
                <Grid x:Name="AudioFlowView" Visibility="Collapsed" Margin="24,14,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Audio Flow" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Text="Visualizes and routes running programs to Leyline channels, virtual buses, and output mixes"
                                       FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="⚡ Install Leyline Virtual Driver (UAC)" Style="{StaticResource MatPrimaryBtn}"
                                    Command="{Binding ProvisionDriverCommand}"/>
                            <Button Content="Refresh Audio Flow" Style="{StaticResource MatBtn}" Command="{Binding RefreshAppsCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <!-- FLOW COL 1: ACTIVE APPLICATIONS -->
                        <Border Grid.Column="0" Background="{ThemeResource BgModalBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="1. ACTIVE APPLICATIONS" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}" Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ActiveAppSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{ThemeResource BgCardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="1" Background="{ThemeResource BgEmptyCellBrush}" CornerRadius="4" Padding="6,1">
                                                                <TextBlock Text="{Binding ProcessIdBadgeText}" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            </Border>
                                                        </Grid>

                                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding PeakLevelDouble, Mode=OneWay}" Height="4" Margin="0,0,0,8"
                                                                     Background="{ThemeResource SliderTrackBrush}" Foreground="{ThemeResource MeterGreenBrush}"/>

                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox Grid.Column="0" Loaded="FlowAppChannelCombo_Loaded" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                                                            <Button Grid.Column="1" Content="Assign →" Tag="{Binding}" Style="{StaticResource MatPrimaryBtn}" Padding="10,5" FontSize="11.5"
                                                                    Click="AssignAppToChannelFromFlow_Click"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1" Text="➔" FontSize="16" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- FLOW COL 2: LEYLINE CHANNELS -->
                        <Border Grid.Column="2" Background="{ThemeResource BgModalBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="2. LEYLINE CHANNELS" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}" Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Channels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{ThemeResource BgCardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                                        Tag="{Binding}" PointerReleased="OpenChannelConfig_PointerReleased">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="28" Height="28" Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}" CornerRadius="6" Margin="0,0,10,0">
                                                                <FontIcon Glyph="{Binding GlyphIcon}" FontSize="13" Foreground="{Binding IconForegroundHex, Converter={StaticResource HexToBrush}}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="2" Background="{ThemeResource BgEmptyCellBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SourceTypeBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                                            </Border>
                                                        </Grid>

                                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding PeakLeftDouble, Mode=OneWay}" Height="4" Margin="0,0,0,6"
                                                                     Background="{ThemeResource SliderTrackBrush}" Foreground="{ThemeResource MeterGreenBrush}"/>

                                                        <TextBlock Text="{Binding RoutedAppsSummary}" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="3" Text="➔" FontSize="16" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- FLOW COL 3: OUTPUT MIXES -->
                        <Border Grid.Column="4" Background="{ThemeResource BgModalBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="3. OUTPUT MIXES" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}" Margin="0,0,0,12"/>

                                <Border Background="{ThemeResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Monitoring Output" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding RenderDevicesWithNone}" SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding MonitorMasterPeakLDouble, Mode=OneWay}" Height="4"
                                                     Background="{ThemeResource SliderTrackBrush}" Foreground="{ThemeResource MeterGreenBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{ThemeResource BgCardBrush}" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Stream Mix Output" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding RenderDevicesWithNone}" SelectedItem="{Binding SelectedStreamDevice, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding StreamMasterPeakLDouble, Mode=OneWay}" Height="4"
                                                     Background="{ThemeResource SliderTrackBrush}" Foreground="{ThemeResource MeterGreenBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ****************************************************************** -->
                <!-- VIEW 2: SOUNDBOARD                                                 -->
                <!-- ****************************************************************** -->
                <Grid x:Name="SoundboardView" Visibility="Collapsed" Margin="24,14,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Soundboard" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Text="Routes directly through the dedicated Soundboard mixer channel • Global Hotkeys work in-game"
                                       FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="⏹ Stop All (Ctrl+Shift+0)" Style="{StaticResource MatBtn}" Command="{Binding StopAllSoundsCommand}"/>
                            <Button Content="+ Add Sound Pad" Style="{StaticResource MatPrimaryBtn}" Click="AddSoundPad_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SoundPads}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="216" Height="132" Background="{ThemeResource BgCardBrush}"
                                            CornerRadius="8" Margin="0,0,12,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" CornerRadius="8,8,0,0"/>

                                            <Button Grid.Row="1" Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                    Padding="14,8" Tag="{Binding}" Click="TriggerSoundPad_Click">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="22"/>
                                                        <Border Grid.Column="1" Background="{ThemeResource BgEmptyCellBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding HotkeyDisplay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>

                                            <Border Grid.Row="2" Background="{ThemeResource BgEmptyCellBrush}" CornerRadius="0,0,8,8" Padding="12,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding VolumePercentText}" FontSize="11"
                                                               Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button Content="Edit" Tag="{Binding}" Background="Transparent"
                                                                Foreground="{ThemeResource TextSecondaryBrush}" BorderThickness="0"
                                                                FontSize="11" Padding="6,2" Click="EditSoundPad_Click"/>
                                                        <Button Content="✕" Tag="{Binding}" Background="Transparent"
                                                                Foreground="#EF5350" BorderThickness="0"
                                                                FontSize="11" Padding="6,2" Click="DeleteSoundPad_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================================================================== -->
        <!-- COMPACT MINI-MIXER MODE (EXACT SCREENSHOT 1 RIGHT WINDOW!)         -->
        <!-- ================================================================== -->
        <Border x:Name="CompactMiniMixerRoot" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource BgWindowBrush}" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Mixes" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Width="32" Height="28" Padding="0" Style="{StaticResource MatBtn}"
                            Click="ToggleCompactWindow_Click" ToolTipService.ToolTip="Expand back to Full Matrix View">
                        <FontIcon Glyph="&#xE740;" FontSize="12"/>
                    </Button>
                </Grid>

                <ComboBox Grid.Row="1" SelectedIndex="0" HorizontalAlignment="Stretch" Height="44"
                          Background="{ThemeResource BgCardBrush}" BorderThickness="0" CornerRadius="8"
                          Margin="0,0,0,12" Padding="14,0" FontSize="13.5" FontWeight="SemiBold">
                    <ComboBoxItem Content="All channels"/>
                    <ComboBoxItem Content="Personal Mix"/>
                    <ComboBoxItem Content="Stream Mix"/>
                </ComboBox>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="58" Background="{ThemeResource BgCardBrush}" CornerRadius="8" Padding="12,0" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}" CornerRadius="7">
                                                <FontIcon Glyph="{Binding GlyphIcon}" FontSize="16"
                                                          Foreground="{Binding IconForegroundHex, Converter={StaticResource HexToBrush}}"/>
                                            </Border>
                                            <Border Background="#42FFFFFF" CornerRadius="4" Padding="3,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"
                                                    Visibility="{Binding HasRoutedApps, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding RoutedAppBadge}" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <ToggleButton Grid.Column="2" Width="30" Height="28" Padding="0" CornerRadius="5"
                                                      Background="{Binding IsInputMuted, Converter={StaticResource MuteToggleBg}}"
                                                      BorderBrush="{Binding IsInputMuted, Converter={StaticResource MixMutedBorder}}"
                                                      BorderThickness="1"
                                                      IsChecked="{Binding IsInputMuted, Mode=TwoWay}" Margin="4,0,8,0">
                                            <FontIcon Glyph="{Binding IsInputMuted, Converter={StaticResource MuteIcon}}" FontSize="13"
                                                      Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        </ToggleButton>
                                        <views:MeterPillSlider Grid.Column="3"
                                                               Value="{Binding InputVolumeDouble, Mode=TwoWay}"
                                                               MeterLeft="{Binding PeakLeftDouble, Mode=OneWay}"
                                                               MeterRight="{Binding PeakRightDouble, Mode=OneWay}"
                                                               IsMutedTheme="{Binding IsInputMuted, Mode=OneWay}"
                                                               VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================================================================== -->
        <!-- CHANNEL CONFIGURATION MODAL (EXACT SCREENSHOT 3 REPLICA!)          -->
        <!-- ================================================================== -->
        <Grid x:Name="ChannelConfigModalOverlay" Grid.RowSpan="2" Background="{ThemeResource ModalOverlayBrush}"
              Visibility="{Binding IsChannelConfigModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="736" Height="532" Background="{ThemeResource BgModalBrush}"
                    BorderBrush="#323237" BorderThickness="1" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding SelectedConfigChannel}">
                <Grid Margin="18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Editable Channel Name TextBox with Lavender Underline + Close X -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="312" Background="{ThemeResource BgCardBrush}" CornerRadius="5"
                                BorderBrush="{ThemeResource AccentPrimaryBrush}" BorderThickness="0,0,0,2">
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="{ThemeResource TextPrimaryBrush}" BorderThickness="0"
                                     FontSize="13" FontWeight="SemiBold" Padding="10,6"/>
                        </Border>

                        <Button Grid.Column="2" Width="30" Height="30" Padding="0"
                                Background="Transparent" Foreground="{ThemeResource TextSecondaryBrush}" BorderThickness="0"
                                Click="CloseChannelConfigModal_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12.5"/>
                        </Button>
                    </Grid>

                    <!-- Center Split: Left Large Icon Preview Card + Right Apps / Audio Effects Container -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="312"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDE: Large Composite Icon Preview Card + Stereo Level Meter (Screenshot 3) -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Button Width="32" Height="26" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,14,0"
                                    Background="Transparent" Foreground="{ThemeResource TextSecondaryBrush}" BorderThickness="0"
                                    Click="CycleChannelColorAndIcon_Click" ToolTipService.ToolTip="Change channel icon &amp; color">
                                <FontIcon Glyph="&#xE712;" FontSize="14"/>
                            </Button>

                            <!-- Big 186x186 Rounded Square Card with +7 Badge (Screenshot 3) -->
                            <Border Width="186" Height="186" Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}" CornerRadius="20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-16,0,0">
                                <Grid>
                                    <FontIcon Glyph="{Binding GlyphIcon}" FontSize="72" Opacity="0.28"
                                              Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <Border Width="44" Height="44" Background="#25000000" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,18,0,0"
                                            Visibility="{Binding HasRoutedApps, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="20" Foreground="#CCFFFFFF"/>
                                    </Border>
                                    <Border Width="54" Height="54" Background="#35000000" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,18"
                                            Visibility="{Binding HasRoutedApps, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE737;" FontSize="24" Foreground="#DDFFFFFF"/>
                                    </Border>

                                    <Border Background="#38FFFFFF" CornerRadius="14" Padding="14,6"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"
                                            Visibility="{Binding HasRoutedApps, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding RoutedAppBadge}" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Bottom Stereo Meter Bar below Large Icon -->
                            <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,18">
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding PeakLeftDouble, Mode=OneWay}" Height="3" Margin="0,0,0,3"
                                             Background="{ThemeResource SliderTrackBrush}" Foreground="{ThemeResource MeterGreenBrush}"/>
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding PeakRightDouble, Mode=OneWay}" Height="3"
                                             Background="{ThemeResource SliderTrackBrush}" Foreground="{ThemeResource MeterGreenBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- RIGHT SIDE: Inner Rounded Panel with "Apps" and "Audio effects" Tabs (Screenshot 3) -->
                        <Border Grid.Column="1" Background="#222226" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Pill Tabs: "Apps" and "Audio effects" -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
                                    <Button x:Name="ModalAppsTabBtn" Content="Apps" Style="{StaticResource MatPrimaryBtn}" Padding="12,5"
                                            Click="ModalAppsTab_Click"/>
                                    <Button x:Name="ModalEffectsTabBtn" Content="Audio effects" Style="{StaticResource MatBtn}" Padding="12,5"
                                            Click="ModalEffectsTab_Click"/>
                                </StackPanel>

                                <!-- TAB A: APPS & INPUT DEVICE CONFIGURATION -->
                                <Grid x:Name="ModalAppsContent" Grid.Row="1" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Hardware Input Device Selector (Microphones Only) -->
                                    <StackPanel Grid.Row="0" Visibility="{Binding IsHardwareInput, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                        <TextBlock Text="Input Capture Device (Microphones Only):" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ModalMicDeviceCombo"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="ModalDeviceCombo_SelectionChanged"/>
                                        <TextBlock Text="Select 'None (Unselected)' to completely disconnect this input channel."
                                                   FontSize="11" Foreground="{ThemeResource TextMutedBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- App Group List (Matches Screenshot 3!) -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding IsAppGroupOrVirtual, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding AssignedApps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="2,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Width="20" Height="20" Background="#2E2E34" CornerRadius="4" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding IconEmoji}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding AppName}" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                                    <TextBlock Text="{Binding AvailabilityText}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="2" Width="28" Height="26" Padding="0"
                                                                        Background="Transparent" Foreground="{ThemeResource TextSecondaryBrush}" BorderThickness="0"
                                                                        Tag="{Binding}" Click="RemoveAssignedApp_Click"
                                                                        ToolTipService.ToolTip="Remove app from channel">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="12.5"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Optional Leyline Virtual Bus Device Picker -->
                                            <StackPanel Margin="0,12,0,4">
                                                <TextBlock Text="Leyline Virtual Audio Bus (Optional):" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="ModalVirtualBusCombo"
                                                          DisplayMemberPath="Name"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="ModalDeviceCombo_SelectionChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Bottom "+ Add app" Button & Inline Picker (Screenshot 3) -->
                                    <StackPanel Grid.Row="2" Visibility="{Binding IsAppGroupOrVirtual, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                        <Border x:Name="AddAppInlinePanel" Visibility="Collapsed" Background="#1A1A1E" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Select running app or browse executable:" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ModalAddAppCombo" Grid.Column="0" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch"/>
                                                    <Button Grid.Column="1" Content="Add" Style="{StaticResource MatPrimaryBtn}" Padding="10,5" FontSize="11"
                                                            Click="ConfirmAddActiveAppToChannel_Click"/>
                                                    <Button Grid.Column="2" Content="Browse .exe" Style="{StaticResource MatBtn}" Padding="8,5" FontSize="11"
                                                            Click="BrowseAppExeForChannel_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Button Content="+   Add app" Background="#323238" Foreground="{ThemeResource TextPrimaryBrush}"
                                                BorderThickness="0" CornerRadius="6" HorizontalAlignment="Stretch" Padding="10,8" FontSize="12.5"
                                                Click="ToggleAddAppInline_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- TAB B: AUDIO EFFECTS (BUILT-IN VST SUITE + EXTERNAL VST CHAIN) -->
                                <ScrollViewer x:Name="ModalEffectsContent" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8" Padding="0,0,4,4">
                                        <!-- Top Built-in VST Header + Pop-out Studio Rack Button -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Built-in Leyline VST Suite" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                                <TextBlock Text="Zero-latency 64-bit internal studio effects chain" FontSize="10.5" Foreground="{ThemeResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🎛️ Pop-Out Rack" Style="{StaticResource MatBtn}" Padding="10,5" FontSize="11"
                                                    Tag="{Binding}" Click="OpenFullFxRackWindow_Click"/>
                                        </Grid>

                                        <!-- Quick Studio Presets Pill Bar -->
                                        <Border Background="#1A1A1E" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Quick Studio Presets:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Reset All" Tag="reset" Click="ApplyBuiltInVstPreset_Click"
                                                            Background="Transparent" Foreground="#EF5350" BorderThickness="0" Padding="6,2" FontSize="10.5"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="Broadcast" Tag="broadcast" Click="ApplyBuiltInVstPreset_Click" Style="{StaticResource MatBtn}" Padding="7,3" FontSize="10.5"/>
                                                    <Button Content="Warm Mic" Tag="warmmic" Click="ApplyBuiltInVstPreset_Click" Style="{StaticResource MatBtn}" Padding="7,3" FontSize="10.5"/>
                                                    <Button Content="Gaming" Tag="gaming" Click="ApplyBuiltInVstPreset_Click" Style="{StaticResource MatBtn}" Padding="7,3" FontSize="10.5"/>
                                                    <Button Content="Music EQ" Tag="music" Click="ApplyBuiltInVstPreset_Click" Style="{StaticResource MatBtn}" Padding="7,3" FontSize="10.5"/>
                                                    <Button Content="Podcast" Tag="podcast" Click="ApplyBuiltInVstPreset_Click" Style="{StaticResource MatBtn}" Padding="7,3" FontSize="10.5"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Pre-Amp Gain Module -->
                                        <Border Background="#1A1A1E" CornerRadius="6" Padding="10,7">
                                            <StackPanel Spacing="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Pre-Amp Input Gain" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding InputGainDbText}" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Content="0 dB" Click="ResetModalPreamp_Click" Style="{StaticResource MatBtn}" Padding="6,2" FontSize="10"/>
                                                </Grid>
                                                <Slider Minimum="-18" Maximum="18" StepFrequency="0.5" Value="{Binding InputGainDbDouble, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 1. VoidGate (Built-in Noise Gate VST) -->
                                        <Border Background="#1A1A1E" CornerRadius="6" Padding="10,8" DataContext="{Binding Dsp}">
                                            <StackPanel Spacing="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding GateEnabled, Mode=TwoWay}" MinWidth="26" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="VoidGate • Noise Gate" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#282830" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="BUILT-IN VST" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                                    </Border>
                                                    <Button Grid.Column="3" Content="Reset" Click="ResetModalGate_Click" Style="{StaticResource MatBtn}" Padding="6,2" FontSize="10"/>
                                                </Grid>

                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <Grid>
                                                            <TextBlock Text="Threshold" FontSize="10.5" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding GateThresholdDbText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Minimum="-75" Maximum="-5" StepFrequency="1" Value="{Binding GateThresholdDbDouble, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <Grid>
                                                            <TextBlock Text="Release" FontSize="10.5" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding GateReleaseMsText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Minimum="20" Maximum="600" StepFrequency="5" Value="{Binding GateReleaseMsDouble, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. VoidEQ (Built-in 3-Band Studio EQ VST) -->
                                        <Border Background="#1A1A1E" CornerRadius="6" Padding="10,8" DataContext="{Binding Dsp}">
                                            <StackPanel Spacing="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding EqEnabled, Mode=TwoWay}" MinWidth="26" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="VoidEQ • 3-Band Studio EQ" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="#282830" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="BUILT-IN VST" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                                    </Border>
                                                    <Button Grid.Column="3" Content="Flat" Click="ResetModalEq_Click" Style="{StaticResource MatBtn}" Padding="6,2" FontSize="10"/>
                                                </Grid>

                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <Grid>
                                                            <TextBlock Text="Low 100Hz" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding EqLowGainDbText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Minimum="-15" Maximum="15" StepFrequency="0.5" Value="{Binding EqLowGainDbDouble, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <Grid>
                                                            <TextBlock Text="Mid 1.1kHz" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding EqMidGainDbText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Minimum="-15" Maximum="15" StepFrequency="0.5" Value="{Binding EqMidGainDbDouble, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Grid>
                                                            <TextBlock Text="High 8kHz" FontSize="10" Foreground="{ThemeResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding EqHighGainDbText}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Minimum="-15" Maximum="15" StepFrequency="0.5" Value="{Binding EqHighGainDbDouble, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. VoidComp (Built-in Studio Compressor VST) -->
                                        <Border Background="#1A1A1E" CornerRadius="6" Padding="10,8" DataContext="{Binding Dsp}">
