<Window
    x:Class="Leyline.Views.AddChannelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Mixer Channel Strip">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgWindowBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18" Spacing="4">
            <TextBlock Text="Add Mixer Channel Strip" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
            <TextBlock Text="Connect a microphone, virtual audio bus, or application into Leyline" FontSize="12.5" Foreground="{ThemeResource TextMutedBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Text="Channel Name" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                <TextBox x:Name="ChannelNameBox" Text="Aux Channel" CornerRadius="10"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Channel Icon" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="IconCombo" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="10">
                        <ComboBoxItem Content="🎙️"/>
                        <ComboBoxItem Content="🎮"/>
                        <ComboBoxItem Content="🌐"/>
                        <ComboBoxItem Content="🎵"/>
                        <ComboBoxItem Content="💬"/>
                        <ComboBoxItem Content="💻"/>
                        <ComboBoxItem Content="🎸"/>
                        <ComboBoxItem Content="📦"/>
                        <ComboBoxItem Content="🔊"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Accent Color" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="ColorCombo" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="10">
                        <ComboBoxItem Content="#7C4DFF"/>
                        <ComboBoxItem Content="#00E5FF"/>
                        <ComboBoxItem Content="#00E676"/>
                        <ComboBoxItem Content="#FF4081"/>
                        <ComboBoxItem Content="#FF9100"/>
                        <ComboBoxItem Content="#40C4FF"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="Audio Source Type" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                <ComboBox x:Name="SourceTypeCombo" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="10" SelectionChanged="SourceTypeCombo_SelectionChanged">
                    <ComboBoxItem Content="Hardware Microphone / Line-In Capture"/>
                    <ComboBoxItem Content="Virtual Audio Bus / Output Device Loopback"/>
                    <ComboBoxItem Content="Direct Application Process Capture (.exe)"/>
                    <ComboBoxItem Content="Custom App Group Channel"/>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="DevicePickerPanel" Spacing="6">
                <TextBlock x:Name="DevicePickerLabel" Text="Select Audio Device" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                <ComboBox x:Name="DeviceCombo" HorizontalAlignment="Stretch" CornerRadius="10" DisplayMemberPath="Name"/>
            </StackPanel>

            <StackPanel x:Name="ProcessPickerPanel" Visibility="Collapsed" Spacing="6">
                <TextBlock Text="Select Active App or Enter Process Name (without .exe)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                <ComboBox x:Name="ProcessCombo" IsEditable="True" HorizontalAlignment="Stretch" CornerRadius="10"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,18,0,0">
            <Button Content="Cancel" Width="105" Padding="12,7" CornerRadius="18"
                    Background="{ThemeResource BgPillBrush}" Foreground="{ThemeResource TextPrimaryBrush}"
                    Click="Cancel_Click"/>
            <Button Content="+ Create Strip" Width="135" Padding="12,7" CornerRadius="18"
                    Background="{ThemeResource AccentPrimaryBrush}" Foreground="{ThemeResource AccentTextOnPrimary}" FontWeight="Bold"
                    Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
