<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Leyline</AssemblyName>
    <RootNamespace>Leyline</RootNamespace>
    <Version>2.0.0</Version>
    <Title>Leyline Audio Mixer &amp; Router (WinUI 3 • Material Design 3)</Title>
    <Description>Google Material Design 3 &amp; WinUI 3 virtual audio router, matrix mixer, soundboard, and VST host for Windows 10 &amp; 11</Description>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <!--
    Leyline Virtual Audio driver package (driver\LeylineVAD\out\<Configuration>, produced by Build-Driver.ps1 and
    Package-Driver.ps1) ships in a Driver\ folder next to Leyline.exe. The app installs or updates the driver
    from there. Falls back to the other configuration's package for local builds.
  -->
  <PropertyGroup>
    <LeylineDriverOut>$(MSBuildThisFileDirectory)..\..\driver\LeylineVAD\out\</LeylineDriverOut>
    <LeylineDriverPackageDir Condition="Exists('$(LeylineDriverOut)$(Configuration)\LeylineVAD.inf')">$(LeylineDriverOut)$(Configuration)\</LeylineDriverPackageDir>
    <LeylineDriverPackageDir Condition="'$(LeylineDriverPackageDir)' == '' and Exists('$(LeylineDriverOut)Release\LeylineVAD.inf')">$(LeylineDriverOut)Release\</LeylineDriverPackageDir>
    <LeylineDriverPackageDir Condition="'$(LeylineDriverPackageDir)' == '' and Exists('$(LeylineDriverOut)Debug\LeylineVAD.inf')">$(LeylineDriverOut)Debug\</LeylineDriverPackageDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(LeylineDriverPackageDir)' != ''">
    <Content Include="$(LeylineDriverPackageDir)LeylineVAD.inf;$(LeylineDriverPackageDir)LeylineVAD.sys;$(LeylineDriverPackageDir)leylinevad.cat;$(LeylineDriverPackageDir)LeylineTestCert.cer"
             Link="Driver\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
