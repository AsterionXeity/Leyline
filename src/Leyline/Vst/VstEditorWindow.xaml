<Window
    x:Class="Leyline.Vst.VstEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Leyline VST Plugin Editor">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Material Design 3 Top App Bar -->
        <Border Grid.Row="0" Background="{ThemeResource BgSidebarBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Background="{ThemeResource AccentPrimaryBrush}" CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock x:Name="FormatBadgeText" Text="VST3" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentTextOnPrimary}"/>
                    </Border>
                    <TextBlock x:Name="PluginTitleText" Text="Plugin Name" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <ToggleButton x:Name="ShowParamsToggle" Content="🎛️  Parameters Rack" Padding="14,6" CornerRadius="16"
                                  Click="ShowParamsToggle_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Native HWND Host Area + Parameter Rack -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ParamColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="NativeHostContainer" Grid.Column="0" Background="#0D0E12" SizeChanged="NativeHostContainer_SizeChanged">
                <TextBlock x:Name="NoGuiHintText"
                           Text="This plugin uses Material 3 parameter controls (shown on the right)."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextMutedBrush}" FontSize="13.5" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Column="1" Background="{ThemeResource BgSidebarBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="VST PARAMETERS" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ParamItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource BgCardBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Units}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{Binding NormalizedValue, Mode=TwoWay}"
                                                    Tag="{Binding}" ValueChanged="ParamSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Material Design 3 Footer -->
        <Border Grid.Row="2" Background="{ThemeResource BgSidebarBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="PluginPathText" Text="" Foreground="{ThemeResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="Close Editor" Padding="16,6" CornerRadius="16"
                        Background="{ThemeResource AccentPrimaryBrush}" Foreground="{ThemeResource AccentTextOnPrimary}" FontWeight="Bold"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
